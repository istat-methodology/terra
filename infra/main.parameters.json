{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "environmentName": {
        "value": "${AZURE_ENV_NAME}"
      },
      "location": {
        "value": "${AZURE_LOCATION}"
      },
      "azureMapsLocation": {
        "value": "${AZUREMAPS_LOCATION:-westeurope}"
      },
      "jsonServerExists": {
        "value": "${SERVICE_JSON_SERVER_RESOURCE_EXISTS=false}"
      },
      "pythonServerExists": {
        "value": "${SERVICE_PYTHON_SERVER_RESOURCE_EXISTS=false}"
      },
      "terraUpdateBatchExists": {
        "value": "${SERVICE_TERRA_UPDATE_BATCH_RESOURCE_EXISTS=false}"
      },
      "principalId": {
        "value": "${AZURE_PRINCIPAL_ID}"
      },
      "principalType": {
        "value": "${AZURE_PRINCIPAL_TYPE}"
      },
      "principalSid": {
        "value": "${AZURE_PRINCIPAL_SID:-null}"
      },
      "jobNotificationsRecipients": {
        "value": "${JOBNOTIFICATIONS_RECIPIENTS}"
      },
      "sqlAdminPassword": {
        "value": "${SQL_ADMIN_PASSWORD:-null}"
      },
      "sendEmailLogicAppName": {
        "value": "${SENDEMAIL_LOGICAPP_NAME:-LASendMailGmail}"
      },
      "sendEmailLogicAppResourceGroup": {
        "value": "${SENDEMAIL_LOGICAPP_RESOURCEGROUP_NAME:-RG-Cosmo}"
      },
      "userTags": {
        "value": { "SecurityControl": "Ignore" }
      }
    }
}
